# Great Sage — Environment Configuration
# Copy this file to .env and fill in values.

# Service authentication — Poneglyph must send this key with requests
GREAT_SAGE_API_KEY=change_me_use_openssl_rand_base64_32

# Webhook configuration — where to deliver results
PONEGLYPH_WEBHOOK_URL=http://localhost:3000/api/internal/webhook/analyze
PONEGLYPH_WEBHOOK_SECRET=change_me_shared_secret

# Ollama LLM configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_TIMEOUT_SECONDS=180

# Processing limits
MAX_UPLOAD_BYTES=15728640
MAX_OCR_TEXT_CHARS=50000
MAX_LLM_INPUT_CHARS=3000
MAX_AI_STRING_LENGTH=255

# Worker configuration
WORKER_QUEUE_SIZE=64
